# Smart Library System Environment Configuration

PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Database Configuration (Defaults to local SQLite if DATABASE_URL is empty)
DATABASE_URL=
SQLITE_DB_PATH=

# Cashfree Sandbox Credentials (For online fine payments)
CASHFREE_APP_ID=your_cashfree_sandbox_app_id
CASHFREE_SECRET_KEY=your_cashfree_sandbox_secret_key
CASHFREE_ENV=SANDBOX

# Google Cloud / Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Smart Library <noreply@example.com>"
